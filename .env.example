# Dark Ralph local provider config.
# Copy to .env and fill only the keys you want to enable.

# Solana
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Market data
BIRDEYE_API_KEY=

# AI providers
XAI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.1

# News and search
NEWS_API_KEY=
SERP_API_KEY=
FINANCIAL_DATASET_API_KEY=

# Optional runtime settings
SOLANA_NETWORK=mainnet-beta
SOLANA_PRIVATE_KEY=
RALPH_AUTO_MODE=true
RALPH_RECURSION_DEPTH=5
RALPH_THOUGHT_INTERVAL=15000
RALPH_MAX_ITERATIONS=10
